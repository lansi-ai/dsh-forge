# 依赖与构建产物
node_modules/
dist/
out/
*.tsbuildinfo
.pnpm-store/
.tmp/
.runtime/

# 打包产物与缓存（M4-a1 electron-builder）
release/
.electron-builder-cache/
# 本地预下载的 electron-builder 工具集（icons 转换工具，绕开沙箱/网络受限环境）
.tools/

# 官网站点构建产物与缓存（VitePress，源在 website/）
website/.vitepress/dist/
website/.vitepress/cache/
website/.vitepress/.temp/

# 环境与密钥
.env
.env.*
!.env.example

# 独立发布的插件包骨架（各自是独立仓库；在此生成后推到新仓库，不进本仓）
plugins/

# 本地数据（$DSH_HOME 共享目录通常位于用户目录，此处仅为仓库内兜底）
.dsh/

# 日志
*.log
npm-debug.log*

# IDE
.idea/
.vscode/
# .trae 已删除（2026-09 弃用 TRAE，规则体系迁移至 docs/，见 docs/PROJECT-RULES.md）
*.swp

# 历史图标源图（tray/app 图标自 2026-09-09 起由 scripts/process-logo.cjs 从 logo.png 生成）
/lansi.jpg
# 品牌 logo 源图（透明底产物由 scripts/process-logo.cjs 生成，源图不入库）
/logo.png
/logo-transparent.png